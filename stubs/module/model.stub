<?php

namespace App\Models;

use App\Models\Concerns\LogsActivity;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\SoftDeletes;

/**
 * %%label%% — generated by `php artisan make:module %%Model%%`.
 *
 * Every create / update / delete is written to the activity log (LogsActivity).
 */
class %%Model%% extends Model
{
    use HasFactory, LogsActivity, SoftDeletes;

    protected $fillable = [%%fillable%%];

    protected function casts(): array
    {
        return [
            %%casts%%
        ];
    }

    public function creator(): BelongsTo
    {
        return $this->belongsTo(User::class, 'created_by')->withTrashed();
    }

    /** Free-text search used by the list page and the API. */
    public function scopeSearch(Builder $query, ?string $term): Builder
    {
        foreach (preg_split('/\s+/u', trim((string) $term), -1, PREG_SPLIT_NO_EMPTY) as $word) {
            $like = '%'.str_replace(['%', '_'], ['\%', '\_'], $word).'%';
            $query->where(function (Builder $q) use ($like) {
                foreach ([%%searchColumns%%] as $column) {
                    $q->orWhere($column, 'like', $like);
                }
            });
        }

        return $query;
    }

    /** How this record is named in the activity log and page titles. */
    public function activityLabel(): string
    {
        return (string) ($this->%%titleField%% ?: '%%label%% #'.$this->getKey());
    }
}
