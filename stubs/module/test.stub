<?php

namespace Tests\Feature\Modules;

use App\Models\%%Model%%;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

/** Generated by `php artisan make:module %%Model%%`. */
class %%Model%%Test extends TestCase
{
    use RefreshDatabase;

    public function test_people_without_the_permission_cannot_open_the_list(): void
    {
        $this->actingAs(User::factory()->create())
            ->get(route('%%route%%.index'))
            ->assertForbidden();
    }

    public function test_the_list_shows_records(): void
    {
        $record = %%Model%%::factory()->create();

        $this->actingAs(User::factory()->withPermissions(['%%permission%%.view' => 1])->create())
            ->get(route('%%route%%.index'))
            ->assertOk()
            ->assertSee(e($record->activityLabel()), false);
    }

    public function test_a_record_can_be_created_and_is_logged(): void
    {
        $user = User::factory()->withPermissions(['%%permission%%.view' => 1, '%%permission%%.create' => 1])->create();

        $this->actingAs($user)
            ->post(route('%%route%%.store'), [
                %%requiredPayload%%
            ])
            ->assertRedirect();

        $record = %%Model%%::firstOrFail();
        $this->assertSame($user->id, $record->created_by);
        $this->assertDatabaseHas('activity_logs', ['action' => 'created', 'subject_type' => $record->getMorphClass(), 'subject_id' => $record->id]);
    }

    public function test_deleting_needs_the_delete_permission(): void
    {
        $record = %%Model%%::factory()->create();
        $viewer = User::factory()->withPermissions(['%%permission%%.view' => 1])->create();

        $this->actingAs($viewer)->delete(route('%%route%%.destroy', $record))->assertForbidden();

        $viewer->forceFill(['permissions' => ['%%permission%%.view' => 1, '%%permission%%.delete' => 1]])->save();
        $this->actingAs($viewer->fresh())->delete(route('%%route%%.destroy', $record))->assertRedirect();
        $this->assertSoftDeleted($record);
    }
}
