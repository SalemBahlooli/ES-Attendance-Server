<?php

namespace App\Http\Controllers;

use App\Http\Requests\%%Model%%Request;
use App\Models\%%Model%%;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controllers\HasMiddleware;
use Illuminate\Routing\Controllers\Middleware;
use Illuminate\View\View;

/**
 * %%labelPlural%%: list, create, view, edit, delete.
 * Generated by `php artisan make:module %%Model%%` — change it freely.
 */
class %%Model%%Controller extends Controller implements HasMiddleware
{
    public static function middleware(): array
    {
        return [
            new Middleware('can:%%permission%%.view'),
            new Middleware('can:%%permission%%.create', only: ['create', 'store']),
            new Middleware('can:%%permission%%.edit', only: ['edit', 'update']),
            new Middleware('can:%%permission%%.delete', only: ['destroy']),
        ];
    }

    public function index(Request $request): View
    {
        $records = %%Model%%::query()
            ->search($request->query('q'))
            ->latest('id')
            ->paginate(setting('per_page', 25))
            ->withQueryString();

        return view('%%view%%.index', ['records' => $records]);
    }

    public function create(): View
    {
        return view('%%view%%.form', ['record' => new %%Model%%]);
    }

    public function store(%%Model%%Request $request): RedirectResponse
    {
        $record = new %%Model%%($request->validated());
        $record->created_by = $request->user()->id;
        $record->save();

        return redirect()->route('%%route%%.show', $record)->with('success', __('Saved.'));
    }

    public function show(%%Model%% $%%model%%): View
    {
        return view('%%view%%.show', ['record' => $%%model%%->load('creator')]);
    }

    public function edit(%%Model%% $%%model%%): View
    {
        return view('%%view%%.form', ['record' => $%%model%%]);
    }

    public function update(%%Model%%Request $request, %%Model%% $%%model%%): RedirectResponse
    {
        $%%model%%->update($request->validated());

        return redirect()->route('%%route%%.show', $%%model%%)->with('success', __('Changes saved.'));
    }

    public function destroy(%%Model%% $%%model%%): RedirectResponse
    {
        $%%model%%->delete();

        return redirect()->route('%%route%%.index')->with('success', __('Deleted.'));
    }
}
