# ---------------------------------------------------------------------------
# Copy to .env and fill in. Most day-to-day options (name, logo, two-factor,
# password rules, Microsoft sign-in, backups...) are changed in the app under
# Settings, not here. This file holds what the server needs to start.
# ---------------------------------------------------------------------------

APP_NAME="ES Attendance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Full public URL, no trailing slash (links in emails are built from it)
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Dates are stored in UTC; this is the default display time zone (Settings → General can change it)
APP_DISPLAY_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# First super user, created by `php artisan db:seed` when there are no users yet.
# Change the password after the first sign-in.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database --------------------------------------------------------------
# docker compose sets these for you (host "mysql"). Outside Docker use your own.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# Sessions MUST stay "database": the "signed-in devices" pages read the sessions table.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site is served over HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail ------------------------------------------------------------------
# Local Docker: Mailpit catches every email at http://localhost:8025
# Production: your SMTP server (Office 365: smtp.office365.com, port 587, scheme null)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Optional --------------------------------------------------------------
# Microsoft sign-in defaults (can also be set in Settings → Single sign-on)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Off-site backups / uploads on S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Protect backup zip files with a password (empty = no password)
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
